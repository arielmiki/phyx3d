{
  "name": "phyx3d",
  "version": "0.2.0",
  "description": "Test 3D prints before printing: printability, stability, strength (FEA), physics and robot/mechanism simulation — web app, CLI and MCP server for AI agents",
  "keywords": [
    "3d-printing",
    "fdm",
    "bambu-lab",
    "stl",
    "3mf",
    "gcode",
    "printability",
    "fea",
    "physics",
    "robotics",
    "simulation",
    "mcp",
    "claude",
    "ai-agents",
    "build123d"
  ],
  "homepage": "https://github.com/arielmiki/phyx3d#readme",
  "bugs": {
    "url": "https://github.com/arielmiki/phyx3d/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arielmiki/phyx3d.git"
  },
  "license": "MIT",
  "author": "phyx3d contributors",
  "type": "module",
  "bin": {
    "phyx3d": "dist/cli.js",
    "phyx3d-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skills",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsup && vite build",
    "build:node": "tsup",
    "prepare": "npm run build",
    "serve": "node dist/cli.js serve",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
