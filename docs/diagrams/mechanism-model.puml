@startuml mechanism-model
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #3B4250
skinparam BorderColor #3B4250
skinparam RoundCorner 8
skinparam ComponentBackgroundColor #EEF0FF
skinparam ClassBackgroundColor #EEF0FF
skinparam ActivityBackgroundColor #EEF0FF
skinparam ParticipantBackgroundColor #EEF0FF
skinparam PackageBackgroundColor #FAFBFF
skinparam DatabaseBackgroundColor #FFF6E5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #3B4250
skinparam ComponentBorderColor #5B6CF0
skinparam ClassBorderColor #5B6CF0
skinparam ActivityBorderColor #5B6CF0
skinparam ActivityDiamondBorderColor #3B4250
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ParticipantBorderColor #5B6CF0
skinparam PackageBorderColor #3B4250
skinparam DatabaseBorderColor #3B4250
skinparam SequenceLifeLineBorderColor #8B93A7
skinparam defaultFontName Helvetica
skinparam shadowing false
hide empty methods
title .mech.json data model

class MechSpec {
  name
  duration : s
  material, infill
  track : part id
}
class Part {
  id
  file | shape
  position, rotation
  material, infill
  mass, extraMass
  fixed, friction, color
}
class Payload {
  mass : g
  at : [x, y, z]
}
class Joint {
  id
  type : revolute | prismatic | ball | fixed
  parent : part id | "world"
  child : part id
  anchor : [x, y, z]
  axis, limits
  collide
}
class Motor {
  preset : SG90 | MG996R | N20 | …
  mode : position | velocity
  target : number | keyframes | expression
  maxTorque, maxSpeed, massOn
}
class Environment {
  floor, friction, slope, gravity
  obstacles
  settle
}

MechSpec "1" *-- "1..*" Part
MechSpec "1" *-- "0..*" Joint
MechSpec "1" *-- "0..1" Environment
Part "1" *-- "0..*" Payload
Joint "1" *-- "0..1" Motor
Joint --> Part : parent
Joint --> Part : child
@enduml
