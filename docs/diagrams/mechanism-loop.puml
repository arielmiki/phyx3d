@startuml mechanism-loop
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #3B4250
skinparam BorderColor #3B4250
skinparam RoundCorner 8
skinparam ComponentBackgroundColor #EEF0FF
skinparam ClassBackgroundColor #EEF0FF
skinparam ActivityBackgroundColor #EEF0FF
skinparam ParticipantBackgroundColor #EEF0FF
skinparam PackageBackgroundColor #FAFBFF
skinparam DatabaseBackgroundColor #FFF6E5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #3B4250
skinparam ComponentBorderColor #5B6CF0
skinparam ClassBorderColor #5B6CF0
skinparam ActivityBorderColor #5B6CF0
skinparam ActivityDiamondBorderColor #3B4250
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ParticipantBorderColor #5B6CF0
skinparam PackageBorderColor #3B4250
skinparam DatabaseBorderColor #3B4250
skinparam SequenceLifeLineBorderColor #8B93A7
skinparam defaultFontName Helvetica
skinparam shadowing false
title Mechanism simulation (src/core/mechanism.ts)

start
:Validate spec (ids, joints, motor presets);
:Build part meshes in assembly coordinates\n(STL files or box / cylinder / sphere);
if (any part fixed?) then (no)
  :Lower the assembly onto the floor;
endif
:Masses = printed estimate + extraMass\n+ point masses (payloads, motors at their joint);
:Colliders per part:\nexact shape | convex hull | convex decomposition | voxel boxes;
:Create joints (revolute / prismatic / ball / fixed)\nwith limits; disable contacts between joined parts;
:Per motor: add gearbox inertia,\nPD gains from rated torque, DC-motor line;
:Time step = smallest stable step of all motors\n(clamped to 1/6000 … 1/1000 s);
repeat
  :Update sensors of the tracked part\n(yaw, pitch, roll, x, y, z, speed);
  :Each motor: evaluate target(t, sensors),\nslew-limit, controller torque,\nclamp to rated torque;
  :Apply equal and opposite torque / force\nto child and parent;
  :world.step();
  :Record poses and motor samples (60 fps);\nlimits, joint drift, collisions (30 Hz);
repeat while (t < duration and stable?) is (yes)
:Metrics: distance, speed, heading drift, tilt, fell?\nmotor p95 / peak / saturation / tracking error\ncollisions, overlaps, joint ranges;
:Findings + fixes + filmstrip PNG;
stop
@enduml
