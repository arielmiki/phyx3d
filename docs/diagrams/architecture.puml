@startuml architecture
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #3B4250
skinparam BorderColor #3B4250
skinparam RoundCorner 8
skinparam ComponentBackgroundColor #EEF0FF
skinparam ClassBackgroundColor #EEF0FF
skinparam ActivityBackgroundColor #EEF0FF
skinparam ParticipantBackgroundColor #EEF0FF
skinparam PackageBackgroundColor #FAFBFF
skinparam DatabaseBackgroundColor #FFF6E5
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #3B4250
skinparam ComponentBorderColor #5B6CF0
skinparam ClassBorderColor #5B6CF0
skinparam ActivityBorderColor #5B6CF0
skinparam ActivityDiamondBorderColor #3B4250
skinparam ActivityDiamondBackgroundColor #FFF6E5
skinparam ParticipantBorderColor #5B6CF0
skinparam PackageBorderColor #3B4250
skinparam DatabaseBorderColor #3B4250
skinparam SequenceLifeLineBorderColor #8B93A7
skinparam componentStyle rectangle
skinparam defaultFontName Helvetica
skinparam shadowing false
title phyx3d — components

actor "You" as user
actor "AI agent\n(Claude Code, Cursor, …)" as agent

package "Front-ends" {
  [Web app\n(Vite + three.js)] as web
  [Web Worker] as worker
  [CLI\nsrc/node/cli.ts] as cli
  [MCP server\nsrc/node/mcp.ts] as mcp
  [HTTP server\nsrc/node/server.ts] as server
}

package "Engine — src/core (TypeScript + WebAssembly)" {
  [loaders\nSTL · 3MF · G-code] as loaders
  [mesh · voxel · geom2d] as geom
  [printability\nstability · warp] as checks
  [fea\n(voxel hexahedra, PCG)] as fea
  [physics\n(drop · tilt · push · stack)] as physics
  [mechanism\n(joints · motors · expr)] as mech
  [gcode · gcodecheck] as gcode
  [analyze · report] as analyze
  [render · png\n(software rasteriser)] as render
}

database "~~/.phyx3d/runs" as runs
[Rapier\n(rigid-body physics)] as rapier
[Bambu Studio CLI\n(optional)] as bambu

user --> web
agent --> mcp
user --> cli
web --> worker
worker --> analyze
cli --> analyze
mcp --> analyze
analyze --> checks
analyze --> fea
analyze --> render
checks --> geom
fea --> geom
physics --> rapier
mech --> rapier
physics --> fea : impact stress
loaders --> geom
analyze ..> loaders
analyze ..> physics
analyze ..> mech
analyze ..> gcode
mcp --> runs : save run
cli --> runs : save run
server --> runs : list / serve
web --> server : /api/runs\n/api/events
cli ..> bambu : slice
mcp ..> bambu : slice_bambu
@enduml
